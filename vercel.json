{
  "version": 2,
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": false,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/assets/logo-small.webp",
      "destination": "/logo-small.webp",
      "permanent": true
    },
    {
      "source": "/assets/brand-poster.jpg",
      "destination": "/brand-poster.jpg",
      "permanent": true
    },
    {
      "source": "/assets/brand-motion.mp4",
      "destination": "/brand-motion.mp4",
      "permanent": true
    },
    {
      "source": "/security.txt",
      "destination": "/.well-known/security.txt",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/.well-known/security.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}
